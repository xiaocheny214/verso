# 复制为 .env 后按需修改。密钥不要提交。
# cp .env.example .env

# ── PostgreSQL（对齐 docker-compose.yml）──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=verso
POSTGRES_PASSWORD=verso_dev
POSTGRES_DB=verso

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── 应用 ──
VERSO_SESSION_COOKIE=verso_session
VERSO_SESSION_TTL_SEC=604800
VERSO_CREATE_TABLES=true
VERSO_ZHIHU_CLIENT_ID=
VERSO_ZHIHU_CLIENT_SECRET=
VERSO_ZHIHU_ACCESS_SECRET=
# 应用只连 LiteLLM。本机 uv 用下面的 localhost；compose 内后端会改写为 http://litellm:4000。
# VERSO_LLM_API_KEY 与 LITELLM_MASTER_KEY 相同。模型名是代理别名，不是上游模型 id。
VERSO_LLM_API_KEY=sk-verso-dev
VERSO_LLM_BASE_URL=http://localhost:4000
VERSO_LLM_MODEL=chat
VERSO_LLM_EMBEDDING_MODEL=embed

# 上游只给 LiteLLM 读。model 必须带供应商前缀：聊天和 embedding 用 openai/，rerank 多用 cohere/。
LITELLM_MASTER_KEY=sk-verso-dev
LITELLM_PORT=4000
LITELLM_CHAT_MODEL=openai/your-chat-model
LITELLM_CHAT_API_BASE=
LITELLM_CHAT_API_KEY=
LITELLM_EMBED_MODEL=openai/your-embedding-model
LITELLM_EMBED_API_BASE=
LITELLM_EMBED_API_KEY=
LITELLM_RERANK_MODEL=cohere/your-rerank-model
LITELLM_RERANK_API_BASE=
LITELLM_RERANK_API_KEY=

# API 进程内消费画像同步队列；单独起 verso-worker 时可设 false。
VERSO_PORTRAIT_SYNC_INLINE=true

# 成色：开户分 / 加减分 / 锁定线。默认 65 且 −5 / 锁定 60 = 两次敷衍机会。
VERSO_REPUTATION_SCORE_MAX=100
VERSO_REPUTATION_INITIAL_SCORE=65
VERSO_REPUTATION_POOR_DELTA=5
VERSO_REPUTATION_GOOD_DELTA=1
VERSO_REPUTATION_MIN_ACTIVE_SCORE=60

# 本机 next dev 用 3000；走宿主机 Nginx 同域反代时改成站点 origin。
VERSO_PUBLIC_ORIGIN=http://localhost:3000
VERSO_ZHIHU_REDIRECT_URI=http://localhost:8000/auth/zhihu/callback

# 同域 Nginx 反代时留空（构建期烘进前端产物，运行期改不动）。
NEXT_PUBLIC_API_BASE=
BACKEND_PORT=8000

# ── 七牛云 Kodo（文章 Markdown 正文）──
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_DOMAIN=
OBJECT_STORAGE_PRIVATE=true
OBJECT_STORAGE_URL_EXPIRES_SEC=3600
OBJECT_STORAGE_KEY_PREFIX=articles

# ── RocketMQ 5 代理（本机直连映射端口；容器内 endpoints 由 compose 覆盖）──
# worker_id 是雪花机器号，单进程用 1。多进程必须各不相同，范围 0..1023。
ROCKETMQ_ENDPOINTS=localhost:8081
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=
ROCKETMQ_TOPIC=verso-job
ROCKETMQ_CONSUMER_GROUP=verso-worker
ROCKETMQ_WORKER_ID=1
ROCKETMQ_PROXY_PORT=8081

# ── Milvus（本机直连 compose 映射端口；容器内 URI 由 compose 覆盖）──
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB=default
MILVUS_COLLECTION=verso_chunks
MILVUS_TIMEOUT_SEC=10
MILVUS_PORT=19530
